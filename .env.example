# =============================================================================
# SmartChat — environment configuration
# Copy to .env and adjust. NEVER commit .env.
# Regenerate every secret before deploying to production.
# =============================================================================

NODE_ENV=development
LOG_LEVEL=debug

# ---- Docker Compose ---------------------------------------------------------
COMPOSE_PROJECT_NAME=smartchat
# Dev by default: base file + dev overlay. For production use:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# ---- Public URLs (as the browser sees them) ---------------------------------
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
REALTIME_URL=http://localhost:3002
WIDGET_URL=http://localhost:3003
TEST_SITE_URL=http://localhost:3004
PUBLIC_KB_URL=http://localhost:3000/kb

# ---- Host port mappings -----------------------------------------------------
WEB_PORT=3000
API_PORT=3001
REALTIME_PORT=3002
WIDGET_PORT=3003
TEST_SITE_PORT=3004
POSTGRES_PORT=55432
REDIS_PORT=56379
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=smartchat
POSTGRES_PASSWORD=smartchat_dev_password
POSTGRES_DB=smartchat
# Used by services running INSIDE the docker network
DATABASE_URL=postgresql://smartchat:smartchat_dev_password@postgres:5432/smartchat?schema=public
# Used when running tooling from the Windows/host shell
DATABASE_URL_HOST=postgresql://smartchat:smartchat_dev_password@localhost:55432/smartchat?schema=public
DATABASE_POOL_MAX=20

# ---- Redis ------------------------------------------------------------------
REDIS_PASSWORD=smartchat_dev_redis
REDIS_URL=redis://:smartchat_dev_redis@redis:6379/0
REDIS_URL_HOST=redis://:smartchat_dev_redis@localhost:56379/0

# ---- Secrets (dev values — regenerate with: openssl rand -hex 32) -----------
SESSION_SECRET=dev_session_secret_change_me_0000000000000000000000000000000000
JWT_SECRET=dev_jwt_secret_change_me_00000000000000000000000000000000000000
VISITOR_TOKEN_SECRET=dev_visitor_secret_change_me_000000000000000000000000000000
ENCRYPTION_KEY=dev_encryption_key_change_me_000000000000000000000000000000
SESSION_TTL_DAYS=30
ACCESS_TOKEN_TTL_MINUTES=15

# ---- Object storage (MinIO in dev, any S3-compatible service in production) --
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=smartchat
S3_ACCESS_KEY=smartchat
S3_SECRET_KEY=smartchat_dev_secret
S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_BYTES=26214400

# ---- Email ------------------------------------------------------------------
MAIL_DRIVER=smtp
MAIL_FROM_ADDRESS=no-reply@smartchat.local
MAIL_FROM_NAME=SmartChat
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ---- Security / limits ------------------------------------------------------
RATE_LIMIT_ENABLED=true
TRUST_PROXY=false
CORS_DASHBOARD_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ---- Platform bootstrap (super admin created by the seed/bootstrap command) --
SUPERADMIN_EMAIL=admin@smartchat.local
SUPERADMIN_PASSWORD=ChangeMe!SuperAdmin1

# ---- Development conveniences ------------------------------------------------
# Skip the email verification step when creating an account locally. Mailpit still receives
# every message, so the real flow can be exercised by setting this to false.
AUTO_VERIFY_EMAIL=false
ALLOW_LOCALHOST_ORIGINS=true
WORKER_CONCURRENCY=5
