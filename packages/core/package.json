{
  "name": "@smartchat/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@node-rs/argon2": "^2.0.2",
    "@smartchat/config": "workspace:*",
    "@smartchat/database": "workspace:*",
    "@smartchat/logger": "workspace:*",
    "@smartchat/types": "workspace:*",
    "@smartchat/validation": "workspace:*",
    "bullmq": "^5.34.10",
    "ioredis": "^5.4.2",
    "linkedom": "^0.18.13",
    "mammoth": "^1.12.2",
    "nodemailer": "^10.0.0",
    "stripe": "^22.6.1",
    "undici": "^8.10.2",
    "unpdf": "^1.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6"
  }
}
