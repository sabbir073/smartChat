// =============================================================================
// SmartChat — database schema
//
// Conventions (see docs/DATABASE.md):
//   • UUIDv7 primary keys, generated in the application (see src/client.ts). The
//     gen_random_uuid() column default exists so `id` is OPTIONAL in the generated types and
//     as a last-resort safety net; the client extension always supplies a v7 value first.
//   • Every tenant-owned table carries account_id.
//   • Child tables reference their parent with a COMPOSITE key that includes
//     account_id, so a cross-tenant reference is impossible at the DB level.
//   • timestamptz everywhere, UTC. created_at / updated_at on every table.
//   • Soft delete (deleted_at) on tenant-visible content.
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum AccountStatus {
  active
  suspended
  pending_deletion

  @@map("account_status")
}

enum MemberRole {
  owner
  admin
  manager
  agent

  @@map("member_role")
}

enum MemberStatus {
  invited
  active
  disabled

  @@map("member_status")
}

enum AgentAvailability {
  online
  away
  offline

  @@map("agent_availability")
}

enum PropertyStatus {
  active
  paused

  @@map("property_status")
}

enum TokenPurpose {
  email_verification
  password_reset
  member_invitation
  email_change

  @@map("token_purpose")
}

enum ConversationStatus {
  open
  pending
  closed

  @@map("conversation_status")
}

enum ConversationPriority {
  low
  normal
  high
  urgent

  @@map("conversation_priority")
}

enum ConversationChannel {
  widget
  offline_form
  email
  api

  @@map("conversation_channel")
}

enum SenderType {
  visitor
  agent
  system
  bot

  @@map("sender_type")
}

enum MessageType {
  text
  file
  image
  system
  note

  @@map("message_type")
}

enum DeviceType {
  desktop
  mobile
  tablet
  bot
  unknown

  @@map("device_type")
}

enum ActorType {
  user
  api_key
  visitor
  system
  platform_admin

  @@map("actor_type")
}

/// What makes a trigger consider firing. Each value is evaluated at a real moment in a visit;
/// there is no polling loop looking for work that might have happened.
enum TriggerEvent {
  /// The visitor's socket connected - the first moment we know they are actually on the site.
  visitor_arrived
  /// The visitor moved to another page, or landed on the first one.
  page_viewed
  /// A wall-clock threshold since the session started, checked on a timer held by their socket.
  time_on_site
  /// The visitor sent their first message.
  conversation_started

  @@map("trigger_event")
}

enum TriggerMatch {
  all
  any

  @@map("trigger_match")
}

/// How often one trigger may fire for one person. `every_time` is still bounded by a cooldown.
/// Where an upload is in its life. A file is invisible to anybody until it is `ready`.
/// Draft until somebody decides it is ready. Nothing public ever serves a draft.
enum ArticleStatus {
  draft
  published

  @@map("article_status")
}

enum AttachmentStatus {
  /// A target has been signed. The bytes may or may not exist yet; nothing trusts this row.
  pending
  /// The object exists, and its size, extension and actual file signature were all checked.
  ready
  /// Verification failed. Kept briefly so the uploader can be told why, then pruned.
  rejected

  @@map("attachment_status")
}

enum ContactFieldType {
  text
  number
  url
  date
  select
  boolean

  @@map("contact_field_type")
}

enum TicketStatus {
  /// Waiting on us.
  open
  /// Waiting on the person who asked. The clock that matters to an agent stops here.
  pending
  /// We believe it is answered. Still reopenable by anybody, and it stays that way.
  resolved
  /// Finished and filed. Reopening makes a new ticket rather than reviving this one.
  closed

  @@map("ticket_status")
}

enum TicketPriority {
  low
  normal
  high
  urgent

  @@map("ticket_priority")
}

enum TicketAuthorType {
  /// The person who asked, whether they typed it in the widget or we transcribed it.
  contact
  agent
  /// Written by the product itself: "opened from an offline message", "resolved automatically".
  system

  @@map("ticket_author_type")
}

enum TicketMessageVisibility {
  /// Sent to the requester by email.
  public
  /// Never leaves the account. The one property this whole feature has to get right.
  internal

  @@map("ticket_message_visibility")
}

enum EmailDeliveryStatus {
  queued
  sent
  failed

  @@map("email_delivery_status")
}

enum TriggerFrequency {
  once_per_session
  once_per_visitor
  every_time

  @@map("trigger_frequency")
}

// -----------------------------------------------------------------------------
// Platform-level tables (NOT tenant-scoped)
// -----------------------------------------------------------------------------

/// Platform administrators are a completely separate identity space from tenant users:
/// separate table, separate credentials, separate sessions. A tenant user can never
/// escalate into this space, because there is no path between the two.
model PlatformAdmin {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String    @unique @db.Citext
  passwordHash     String    @map("password_hash")
  name             String
  permissions      String[]  @default([])
  isActive         Boolean   @default(true) @map("is_active")
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(6)
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions PlatformSession[]

  @@map("platform_admins")
}

model PlatformSession {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId    String    @map("admin_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, expiresAt])
  @@map("platform_sessions")
}

// -----------------------------------------------------------------------------
// Identity
// -----------------------------------------------------------------------------

model User {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String    @unique @db.Citext
  /// Null until the person sets one. A user row is created the moment somebody is invited, so a
  /// membership can point at it, but nobody can sign in as them until they accept. `verifyPassword`
  /// treats a null hash as never matching, so this cannot become an authentication bypass.
  passwordHash       String?   @map("password_hash")
  name               String
  avatarUrl          String?   @map("avatar_url")
  locale             String    @default("en")
  timezone           String    @default("UTC")
  emailVerifiedAt    DateTime? @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(6)
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(6)
  /// 2FA-ready: populated only once a user enrols. Encrypted at rest.
  twoFactorSecret    String?   @map("two_factor_secret")
  twoFactorEnabledAt DateTime? @map("two_factor_enabled_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  sessions       Session[]
  memberships    AccountMember[]
  tokens         VerificationToken[]
  ownedAccounts  Account[]           @relation("AccountOwner")
  invitationsWon AccountMember[]     @relation("MemberInviter")

  @@index([deletedAt])
  @@map("users")
}

/// Opaque server-side session. `tokenHash` is sha256(token); the raw token exists only in
/// the user's cookie, so a database leak does not hand an attacker live sessions.
model Session {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  csrfSecret String    @map("csrf_secret")
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// Single-use, hashed, expiring tokens for email verification, password reset and invitations.
model VerificationToken {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purpose    TokenPurpose
  tokenHash  String       @unique @map("token_hash")
  email      String       @db.Citext
  userId     String?      @map("user_id") @db.Uuid
  accountId  String?      @map("account_id") @db.Uuid
  metadata   Json         @default("{}")
  expiresAt  DateTime     @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?    @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@index([expiresAt])
  @@map("verification_tokens")
}

// -----------------------------------------------------------------------------
// Tenancy
// -----------------------------------------------------------------------------

model Account {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  slug              String        @unique @db.Citext
  status            AccountStatus @default(active)
  timezone          String        @default("UTC")
  locale            String        @default("en")
  ownerUserId       String?       @map("owner_user_id") @db.Uuid
  suspendedAt       DateTime?     @map("suspended_at") @db.Timestamptz(6)
  suspendedReason   String?       @map("suspended_reason")
  /// null = keep forever. Drives the retention cleanup job.
  dataRetentionDays Int?          @map("data_retention_days")
  /**
   * The last ticket number handed out in this account.
   * Incremented inside the transaction that inserts the ticket, so numbers are gapless and unique
   * per account - a person quoting "ticket 412" is quoting something that exists exactly once.
   */
  ticketSeq         Int           @default(0) @map("ticket_seq")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz(6)

  owner              User?                    @relation("AccountOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  members            AccountMember[]
  roles              Role[]
  departments        Department[]
  properties         Property[]
  visitors           Visitor[]
  conversations      Conversation[]
  auditLogs          AuditLog[]
  tokens             VerificationToken[]
  triggers           Trigger[]
  shortcuts          Shortcut[]
  attachments        Attachment[]
  kbCategories       KbCategory[]
  kbArticles         KbArticle[]
  contacts           Contact[]
  contactFields      ContactFieldDefinition[]
  tickets            Ticket[]
  ticketMessages     TicketMessage[]
  emailDeliveries    EmailDelivery[]
  dailyMetrics       DailyMetric[]
  dailyAgentMetrics  DailyAgentMetric[]
  apiKeys            ApiKey[]
  webhooks           Webhook[]
  webhookDeliveries  WebhookDelivery[]
  subscription       Subscription?
  invoices           Invoice[]
  billingEnquiries   BillingEnquiry[]
  aiSettings         AiSetting[]
  knowledgeDocuments KnowledgeDocument[]
  knowledgeChunks    KnowledgeChunk[]
  knowledgeFiles     KnowledgeFile[]
  aiTurns            AiTurn[]

  @@index([status, deletedAt])
  @@map("accounts")
}

model AccountMember {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId              String            @map("account_id") @db.Uuid
  userId                 String            @map("user_id") @db.Uuid
  roleId                 String?           @map("role_id") @db.Uuid
  baseRole               MemberRole        @default(agent) @map("base_role")
  status                 MemberStatus      @default(active)
  availability           AgentAvailability @default(offline)
  displayName            String?           @map("display_name")
  title                  String?
  /// When true this member only sees the properties listed in property_members.
  restrictedToProperties Boolean           @default(false) @map("restricted_to_properties")
  invitedByUserId        String?           @map("invited_by_user_id") @db.Uuid
  invitedAt              DateTime?         @map("invited_at") @db.Timestamptz(6)
  joinedAt               DateTime?         @map("joined_at") @db.Timestamptz(6)
  lastActiveAt           DateTime?         @map("last_active_at") @db.Timestamptz(6)
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?         @map("deleted_at") @db.Timestamptz(6)

  account                Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                   Role?              @relation(fields: [roleId], references: [id], onDelete: SetNull)
  invitedBy              User?              @relation("MemberInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  properties             PropertyMember[]
  departments            DepartmentMember[]
  assignedConversations  Conversation[]     @relation("ConversationAssignee")
  sentMessages           Message[]
  reads                  ConversationRead[]
  authoredTriggers       Trigger[]          @relation("TriggerAuthor")
  authoredShortcuts      Shortcut[]         @relation("ShortcutAuthor")
  assignedTickets        Ticket[]           @relation("TicketAssignee")
  authoredTicketMessages TicketMessage[]    @relation("TicketMessageAuthor")
  dailyAgentMetrics      DailyAgentMetric[]

  @@unique([accountId, userId])
  @@unique([accountId, id])
  @@index([accountId, status, deletedAt])
  @@index([userId])
  @@map("account_members")
}

/// A role is a named, editable set of permission strings. Permissions live in a text[] rather
/// than a join table: the set is small, always read whole, and never queried by permission.
model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId   String   @map("account_id") @db.Uuid
  key         String   @db.Citext
  name        String
  description String?
  permissions String[] @default([])
  /// System roles are created with the account and cannot be deleted, only edited.
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  account Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  members AccountMember[]

  @@unique([accountId, key])
  @@unique([accountId, id])
  @@map("roles")
}

// -----------------------------------------------------------------------------
// Properties (websites)
// -----------------------------------------------------------------------------

model Property {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId           String         @map("account_id") @db.Uuid
  /// Safe to expose in the customer's page source. Identifies, authorises nothing.
  publicId            String         @unique @map("public_id")
  name                String
  websiteUrl          String         @map("website_url")
  status              PropertyStatus @default(active)
  timezone            String         @default("UTC")
  locale              String         @default("en")
  /// When false, unknown origins are recorded instead of blocked, so a misconfigured
  /// install surfaces in the dashboard rather than silently failing.
  enforceDomains      Boolean        @default(false) @map("enforce_domains")
  /**
   * Where a requester's email reply should go.
   * SmartChat does not receive mail, so this is the customer's own mailbox and it is used as
   * `Reply-To` on ticket email. When it is not set, no `Reply-To` is written and the message says
   * plainly that the address is not monitored - a reply-to nobody reads is worse than none.
   */
  supportEmail        String?        @map("support_email") @db.Citext
  installedAt         DateTime?      @map("installed_at") @db.Timestamptz(6)
  lastWidgetRequestAt DateTime?      @map("last_widget_request_at") @db.Timestamptz(6)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?      @map("deleted_at") @db.Timestamptz(6)

  account            Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  domains            PropertyDomain[]
  members            PropertyMember[]
  widget             Widget?
  visitors           Visitor[]
  sessions           VisitorSession[]
  conversations      Conversation[]
  triggers           Trigger[]
  attachments        Attachment[]
  kbCategories       KbCategory[]
  kbArticles         KbArticle[]
  tickets            Ticket[]
  dailyMetrics       DailyMetric[]
  aiSetting          AiSetting?
  knowledgeDocuments KnowledgeDocument[]
  knowledgeFiles     KnowledgeFile[]
  aiTurns            AiTurn[]

  @@unique([accountId, id])
  @@index([accountId, deletedAt])
  @@map("properties")
}

model PropertyDomain {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId  String   @map("account_id") @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  /// Stored normalised and lowercased: "example.com" or "*.example.com".
  pattern    String   @db.Citext
  isWildcard Boolean  @default(false) @map("is_wildcard")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  property Property @relation(fields: [accountId, propertyId], references: [accountId, id], onDelete: Cascade)

  @@unique([propertyId, pattern])
  @@index([accountId])
  @@map("property_domains")
}

/// Scopes a restricted member to specific properties.
model PropertyMember {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId  String   @map("account_id") @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  memberId   String   @map("member_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  property Property      @relation(fields: [accountId, propertyId], references: [accountId, id], onDelete: Cascade)
  member   AccountMember @relation(fields: [accountId, memberId], references: [accountId, id], onDelete: Cascade)

  @@unique([propertyId, memberId])
  @@index([accountId, memberId])
  @@map("property_members")
}

/// A named group of agents - "Sales", "Billing" - that a conversation can belong to.
///
/// Departments exist so an account can divide an inbox by responsibility rather than by website.
/// Membership is many-to-many: one person is often on two desks.
model Department {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId   String  @map("account_id") @db.Uuid
  name        String
  /// Stable, human-readable handle. Unique per account, used in the API and in routing rules.
  key         String  @db.Citext
  description String?
  /// Where a conversation lands when nothing else decides. At most one per account; enforced in
  /// the service rather than by a partial unique index, which Prisma cannot express.
  isDefault   Boolean @default(false) @map("is_default")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  account       Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  members       DepartmentMember[]
  conversations Conversation[]
  tickets       Ticket[]

  @@unique([accountId, id])
  @@unique([accountId, key])
  @@index([accountId, deletedAt])
  @@map("departments")
}

model DepartmentMember {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId    String   @map("account_id") @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  memberId     String   @map("member_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  department Department    @relation(fields: [accountId, departmentId], references: [accountId, id], onDelete: Cascade)
  member     AccountMember @relation(fields: [accountId, memberId], references: [accountId, id], onDelete: Cascade)

  @@unique([departmentId, memberId])
  @@index([accountId, memberId])
  @@map("department_members")
}

// -----------------------------------------------------------------------------
// Audit
// -----------------------------------------------------------------------------

/// Append-only. Nothing in the application updates or deletes these rows.
model AuditLog {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId    String?   @map("account_id") @db.Uuid
  actorType    ActorType @map("actor_type")
  actorId      String?   @map("actor_id") @db.Uuid
  actorLabel   String?   @map("actor_label")
  action       String
  resourceType String    @map("resource_type")
  resourceId   String?   @map("resource_id")
  ip           String?
  userAgent    String?   @map("user_agent")
  metadata     Json      @default("{}")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// Widget
// -----------------------------------------------------------------------------

/// One widget per property.
///
/// Appearance, placement, behaviour, content and form definitions live in a single JSON document
/// validated by `widgetConfigSchema` in @smartchat/validation, rather than in ~40 columns. The
/// config surface grows constantly and is always read and written whole; a Zod schema plus a
/// version number gives type safety and a migration path without a DDL change per setting.
model Widget {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId   String    @map("account_id") @db.Uuid
  propertyId  String    @unique @map("property_id") @db.Uuid
  /// The live configuration the widget serves to visitors.
  config      Json      @default("{}")
  /// Unpublished edits from the builder. Null once published.
  draftConfig Json?     @map("draft_config")
  /// Incremented on publish. Lets a cached loader detect that it has stale config.
  version     Int       @default(1)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  property Property @relation(fields: [accountId, propertyId], references: [accountId, id], onDelete: Cascade)

  @@unique([accountId, id])
  // Required by Prisma for a one-to-one across a composite key, and correct on its own terms:
  // exactly one widget per property, and the pair can never straddle two accounts.
  @@unique([accountId, propertyId])
  @@index([accountId])
  @@map("widgets")
}

// -----------------------------------------------------------------------------
// Visitors
// -----------------------------------------------------------------------------

/// A durable visitor identity, scoped to one property.
///
/// The same person on two of an account's websites is two visitors: properties are isolated, and
/// silently joining them across sites would be both a privacy problem and a surprise.
model Visitor {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId  String  @map("account_id") @db.Uuid
  propertyId String  @map("property_id") @db.Uuid
  /// Supplied by the customer's site via SmartChat('identify'). Never trusted for authorisation.
  externalId String? @map("external_id")
  name       String?
  email      String? @db.Citext
  phone      String?

  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  visitCount  Int      @default(1) @map("visit_count")

  country    String?    @db.Char(2)
  region     String?
  city       String?
  timezone   String?
  language   String?
  browser    String?
  os         String?
  deviceType DeviceType @default(unknown) @map("device_type")

  /// The person behind this browser, once we know their email address. Null until then.
  contactId String? @map("contact_id") @db.Uuid

  /// Abuse control. A ban blocks new conversations and messages, not page views.
  isBanned    Boolean   @default(false) @map("is_banned")
  bannedUntil DateTime? @map("banned_until") @db.Timestamptz(6)
  banReason   String?   @map("ban_reason")

  metadata  Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  account        Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  property       Property         @relation(fields: [accountId, propertyId], references: [accountId, id], onDelete: Cascade)
  sessions       VisitorSession[]
  conversations  Conversation[]
  triggerFirings TriggerFiring[]
  contact        Contact?         @relation(fields: [accountId, contactId], references: [accountId, id], onDelete: SetNull)

  @@unique([accountId, id])
  @@unique([propertyId, externalId])
  @@index([accountId, propertyId, lastSeenAt(sort: Desc)])
  @@index([propertyId, email])
  @@index([accountId, contactId])
  // Inbox search by who the visitor is. Two separate trigram indexes rather than one composite:
  // a search matches either column on its own, and a combined index could serve neither alone.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("visitors")
}

/// One browsing session. High-churn and pruned by the retention job; visitors are kept.
model VisitorSession {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId  String @map("account_id") @db.Uuid
  propertyId String @map("property_id") @db.Uuid
  visitorId  String @map("visitor_id") @db.Uuid

  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  endedAt    DateTime? @map("ended_at") @db.Timestamptz(6)

  ip           String?
  userAgent    String? @map("user_agent")
  referrer     String?
  landingUrl   String? @map("landing_url")
  currentUrl   String? @map("current_url")
  currentTitle String? @map("current_title")

  browser      String?
  os           String?
  deviceType   DeviceType @default(unknown) @map("device_type")
  screenWidth  Int?       @map("screen_width")
  screenHeight Int?       @map("screen_height")
  language     String?
  country      String?    @db.Char(2)
  region       String?
  city         String?

  pageViewCount Int @default(0) @map("page_view_count")

  visitor   Visitor           @relation(fields: [accountId, visitorId], references: [accountId, id], onDelete: Cascade)
  property  Property          @relation(fields: [accountId, propertyId], references: [accountId, id], onDelete: Cascade)
  pageViews VisitorPageView[]

  @@unique([accountId, id])
  @@index([accountId, visitorId, startedAt(sort: Desc)])
  @@index([propertyId, lastSeenAt(sort: Desc)])
  @@map("visitor_sessions")
}

model VisitorPageView {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId  String   @map("account_id") @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  visitorId  String   @map("visitor_id") @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  url        String
  title      String?
  referrer   String?
  viewedAt   DateTime @default(now()) @map("viewed_at") @db.Timestamptz(6)

  session VisitorSession @relation(fields: [accountId, sessionId], references: [accountId, id], onDelete: Cascade)

  @@index([accountId, sessionId, viewedAt])
  @@index([propertyId, viewedAt(sort: Desc)])
  @@map("visitor_page_views")
}

// -----------------------------------------------------------------------------
// Conversations and messages
// -----------------------------------------------------------------------------

/// One thread between a visitor and the account's agents.
model Conversation {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId  String @map("account_id") @db.Uuid
  propertyId String @map("property_id") @db.Uuid
  visitorId  String @map("visitor_id") @db.Uuid

  status   ConversationStatus   @default(open)
  priority ConversationPriority @default(normal)
  channel  ConversationChannel  @default(widget)

  /// Assignment is to a *membership*, not a user: the same person in two accounts is two members,
  /// and a conversation must never reference the wrong one.
  assignedMemberId String? @map("assigned_member_id") @db.Uuid

  /// Which desk owns this conversation. Null means nobody has decided yet.
  departmentId String? @map("department_id") @db.Uuid

  /**
   * The gapless per-conversation message counter.
   * Incremented in the same transaction as every message insert. Ordering and reconnect replay
   * both use it, because wall-clock timestamps are ambiguous under clock skew and same-millisecond
   * writes. See docs/REALTIME.md.
   */
  messageSeq BigInt @default(0) @map("message_seq")

  subject     String?
  /// Whatever the pre-chat form collected. Claims from the visitor, never authorisation.
  preChatData Json     @default("{}") @map("pre_chat_data")
  tags        String[] @default([])
  metadata    Json     @default("{}")

  startedAt            DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  lastMessageAt        DateTime  @default(now()) @map("last_message_at") @db.Timestamptz(6)
  lastVisitorMessageAt DateTime? @map("last_visitor_message_at") @db.Timestamptz(6)
  lastAgentMessageAt   DateTime? @map("last_agent_message_at") @db.Timestamptz(6)
  /// First agent reply. The basis of the response-time report, so it is recorded once and never
  /// overwritten.
  firstResponseAt      DateTime? @map("first_response_at") @db.Timestamptz(6)
  closedAt             DateTime? @map("closed_at") @db.Timestamptz(6)
  closedByMemberId     String?   @map("closed_by_member_id") @db.Uuid

  /// Maintained counters rather than COUNT(*) over messages, which would be the single most
  /// expensive query in the inbox.
  visitorUnreadCount Int @default(0) @map("visitor_unread_count")
  agentUnreadCount   Int @default(0) @map("agent_unread_count")

  // --- the AI agent ----------------------------------------------------------
  /// How many times the AI has answered here. Bounded by the property's setting so a visitor is
  /// never kept in a loop with a machine.
  aiReplyCount  Int       @default(0) @map("ai_reply_count")
  aiLastReplyAt DateTime? @map("ai_last_reply_at") @db.Timestamptz(6)
  /// Set the moment a person replies or takes the assignment. The AI never speaks in this
  /// conversation again, whatever the mode says.
  aiPausedAt    DateTime? @map("ai_paused_at") @db.Timestamptz(6)
  /// The AI decided a person is needed while the team was online. The inbox shows it as waiting.
  aiHandoffAt   DateTime? @map("ai_handoff_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  account        Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  property       Property           @relation(fields: [accountId, propertyId], references: [accountId, id], onDelete: Cascade)
  visitor        Visitor            @relation(fields: [accountId, visitorId], references: [accountId, id], onDelete: Cascade)
  assignedMember AccountMember?     @relation("ConversationAssignee", fields: [accountId, assignedMemberId], references: [accountId, id], onDelete: SetNull)
  department     Department?        @relation(fields: [accountId, departmentId], references: [accountId, id], onDelete: SetNull)
  messages       Message[]
  reads          ConversationRead[]
  triggerFirings TriggerFiring[]
  attachments    Attachment[]
  tickets        Ticket[]
  aiTurns        AiTurn[]

  @@unique([accountId, id])
  // Drives the inbox list.
  @@index([accountId, propertyId, status, lastMessageAt(sort: Desc)])
  // Drives "assigned to me".
  @@index([accountId, assignedMemberId, status, lastMessageAt(sort: Desc)])
  // Drives the visitor's own history and the widget's "resume my conversation".
  @@index([accountId, visitorId, lastMessageAt(sort: Desc)])
  // Drives "everything on my desk".
  @@index([accountId, departmentId, status, lastMessageAt(sort: Desc)])
  // Inbox search by subject. A substring match cannot use a B-tree, so this is a trigram GIN
  // index. Single-column on purpose: Prisma cannot express a btree_gin composite containing a
  // uuid, and the planner combines this bitmap with the account_id indexes above anyway.
  @@index([subject(ops: raw("gin_trgm_ops"))], type: Gin)
  // Tag filtering. tags is an array, so containment is the operator and GIN is the index.
  @@index([tags], type: Gin)
  @@map("conversations")
}

/// The largest table in the system. Target: 10^8 rows. See docs/DATABASE.md.
model Message {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId      String @map("account_id") @db.Uuid
  propertyId     String @map("property_id") @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid

  /// Gapless within the conversation. Assigned in the same transaction as the insert.
  seq BigInt

  /**
   * Client-generated, so a retry after a lost acknowledgement is idempotent rather than a
   * duplicate. The unique index below is what actually enforces that.
   */
  clientMessageId String? @map("client_message_id")

  senderType      SenderType @map("sender_type")
  senderMemberId  String?    @map("sender_member_id") @db.Uuid
  senderVisitorId String?    @map("sender_visitor_id") @db.Uuid

  type     MessageType @default(text)
  /// Stored exactly as received. Sanitised at render, never on write - so the record of what was
  /// actually said stays intact.
  body     String
  metadata Json        @default("{}")

  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  editedAt    DateTime? @map("edited_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation   @relation(fields: [accountId, conversationId], references: [accountId, id], onDelete: Cascade)
  sender       AccountMember? @relation(fields: [accountId, senderMemberId], references: [accountId, id], onDelete: SetNull)

  @@unique([conversationId, seq])
  @@unique([conversationId, clientMessageId])
  // Keyset pagination within a conversation.
  @@index([conversationId, seq(sort: Desc)])
  @@index([accountId, createdAt(sort: Desc)])
  // Inbox search by what was actually said. Without this, searching the largest table in the
  // system is a sequential scan; with it the planner can BitmapAnd it against the account_id
  // index above, so the tenant filter still happens before rows are read.
  @@index([body(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("messages")
}

/// How far each agent has read in a conversation. One row per member per conversation.
model ConversationRead {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  memberId       String   @map("member_id") @db.Uuid
  lastReadSeq    BigInt   @default(0) @map("last_read_seq")
  readAt         DateTime @default(now()) @map("read_at") @db.Timestamptz(6)

  conversation Conversation  @relation(fields: [accountId, conversationId], references: [accountId, id], onDelete: Cascade)
  member       AccountMember @relation(fields: [accountId, memberId], references: [accountId, id], onDelete: Cascade)

  @@unique([conversationId, memberId])
  @@index([accountId, memberId])
  @@map("conversation_reads")
}

// -----------------------------------------------------------------------------
// Automation
// -----------------------------------------------------------------------------

/**
 * A rule: when this happens, and these things are true, do that.
 * Conditions and actions are JSON rather than tables. They are always read whole, always written
 * whole, and never queried by their contents - so a join table would buy nothing and cost a
 * multi-row write on every edit. What keeps them honest is that both are parsed by a Zod schema on
 * write and on read; an action shape that no longer exists cannot be stored, and one that has
 * somehow survived a downgrade is rejected at evaluation rather than half-executed.
 */
model Trigger {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId  String  @map("account_id") @db.Uuid
  /// Null means every website in the account. A trigger scoped to one property only ever sees
  /// visitors of that property.
  propertyId String? @map("property_id") @db.Uuid

  name        String
  description String?
  event       TriggerEvent
  enabled     Boolean      @default(true)
  match       TriggerMatch @default(all)

  /// `TriggerCondition[]`, validated by @smartchat/validation on every write and every read.
  conditions Json @default("[]")
  /// `TriggerAction[]`, same contract.
  actions    Json @default("[]")

  frequency       TriggerFrequency @default(once_per_session)
  /// Applies to `every_time`: the shortest gap between two firings for the same visitor.
  cooldownSeconds Int              @default(60) @map("cooldown_seconds")
  /// `time_on_site` only: how long into the session this becomes eligible.
  afterSeconds    Int              @default(0) @map("after_seconds")

  /// Evaluation order within an event. Lower runs first; the first trigger that fires wins.
  position Int @default(0)

  /// Maintained counters. Read by the UI, so they are the real thing rather than a COUNT(*) over
  /// a table the retention job prunes.
  fireCount   Int       @default(0) @map("fire_count")
  lastFiredAt DateTime? @map("last_fired_at") @db.Timestamptz(6)

  createdByMemberId String? @map("created_by_member_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  account   Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  property  Property?       @relation(fields: [accountId, propertyId], references: [accountId, id], onDelete: Cascade)
  createdBy AccountMember?  @relation("TriggerAuthor", fields: [accountId, createdByMemberId], references: [accountId, id], onDelete: SetNull)
  firings   TriggerFiring[]

  @@unique([accountId, id])
  /// The gateway's hot path: every enabled trigger for one event, in order.
  @@index([accountId, event, enabled, position])
  @@index([accountId, propertyId, deletedAt])
  @@map("triggers")
}

/**
 * One firing. This table is what makes "once per visitor" true rather than best-effort.
 * `dedupeKey` is null for `every_time` triggers, and Postgres treats nulls in a unique index as
 * distinct - so the same index enforces at-most-once for the two capped frequencies and imposes
 * nothing on the uncapped one, without a partial index Prisma cannot express.
 */
model TriggerFiring {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId  String  @map("account_id") @db.Uuid
  triggerId  String  @map("trigger_id") @db.Uuid
  propertyId String  @map("property_id") @db.Uuid
  visitorId  String  @map("visitor_id") @db.Uuid
  /// Not a foreign key on purpose: visitor sessions are pruned by the retention job, and a firing
  /// is a fact about a person, not about a row that will not outlive the month.
  sessionId  String? @map("session_id") @db.Uuid

  conversationId String? @map("conversation_id") @db.Uuid

  dedupeKey String?  @map("dedupe_key")
  firedAt   DateTime @default(now()) @map("fired_at") @db.Timestamptz(6)

  trigger      Trigger       @relation(fields: [accountId, triggerId], references: [accountId, id], onDelete: Cascade)
  visitor      Visitor       @relation(fields: [accountId, visitorId], references: [accountId, id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [accountId, conversationId], references: [accountId, id], onDelete: SetNull)

  @@unique([triggerId, dedupeKey])
  /// Drives the cooldown check for `every_time`.
  @@index([accountId, triggerId, visitorId, firedAt(sort: Desc)])
  @@index([accountId, firedAt(sort: Desc)])
  @@map("trigger_firings")
}

/**
 * A canned response, addressed by the token an agent types after "/".
 * Account-wide and shared, deliberately: a saved reply is a team asset, and per-agent private
 * shortcuts would mean two people typing the same "/refund" and getting different text, which is
 * exactly the inconsistency the feature exists to remove.
 */
model Shortcut {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  /// Typed after "/". Lowercase, unique within the account - enforced below, not just in the UI.
  key   String @db.Citext
  title String
  body  String

  /// Maintained by the composer when a shortcut is actually inserted, so the list can be ordered
  /// by what the team really uses.
  usageCount Int @default(0) @map("usage_count")

  createdByMemberId String? @map("created_by_member_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  account   Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy AccountMember? @relation("ShortcutAuthor", fields: [accountId, createdByMemberId], references: [accountId, id], onDelete: SetNull)

  @@unique([accountId, id])
  @@unique([accountId, key])
  @@index([accountId, deletedAt, usageCount(sort: Desc)])
  @@map("shortcuts")
}

// -----------------------------------------------------------------------------
// Files
// -----------------------------------------------------------------------------

/**
 * One uploaded file.
 * The bytes live in object storage; this row is the record of what they are. Nothing here is taken
 * from the client except the original file name, which is sanitised before it is stored and never
 * used to build a storage key. `contentType` is what the bytes actually turned out to be when
 * their signature was read - not what the browser claimed.
 * A row is created when an upload target is signed and is `pending` until the object has been
 * fetched back and checked. Nothing outside this service can see a pending attachment, so a signed
 * target that is never used, or is used to store something else entirely, produces a row that is
 * rejected and pruned rather than a file anybody can reach.
 */
model Attachment {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId      String @map("account_id") @db.Uuid
  propertyId     String @map("property_id") @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid

  /**
   * The message this file was sent as, once it has been sent.
   * Not a foreign key, deliberately. Referencing `messages` across the tenant key would mean a
   * unique index on `(account_id, id)` over the largest table in the system - gigabytes, to
   * enforce a link that the conversation foreign key already protects: deleting a conversation
   * takes its messages and its attachments together, so an attachment cannot outlive its message.
   */
  messageId String? @map("message_id") @db.Uuid

  uploaderType      SenderType @map("uploader_type")
  uploaderMemberId  String?    @map("uploader_member_id") @db.Uuid
  uploaderVisitorId String?    @map("uploader_visitor_id") @db.Uuid

  /// Derived server-side from ids we already trust. Never from anything a client sent.
  storageKey String @unique @map("storage_key")
  bucket     String

  /// The original name, sanitised for display and for the download header. Not part of the key.
  fileName    String  @map("file_name")
  /// Decided by reading the first bytes of the stored object. The client's claim is not stored.
  contentType String  @map("content_type")
  byteSize    Int     @map("byte_size")
  checksum    String?
  width       Int?
  height      Int?

  status          AttachmentStatus @default(pending)
  rejectionReason String?          @map("rejection_reason")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [accountId, propertyId], references: [accountId, id], onDelete: Cascade)
  conversation Conversation @relation(fields: [accountId, conversationId], references: [accountId, id], onDelete: Cascade)

  @@unique([accountId, id])
  /// Rendering a thread: every ready file in one conversation.
  @@index([accountId, conversationId, status])
  /// The reverse lookup when a thread is loaded message by message.
  @@index([messageId])
  /// The cleanup job: pending rows that were never confirmed, and rejected ones.
  @@index([status, createdAt])
  @@map("attachments")
}

// -----------------------------------------------------------------------------
// Contacts
// -----------------------------------------------------------------------------

/**
 * A person, at account level.
 * A `Visitor` is a browser on one website; a contact is the human behind however many of those
 * there are. They are joined the moment we learn an email address, which is the only identifier a
 * support product can rely on - and the join is explicit rather than implied by a query, so an
 * agent can see which visits belong to the same person and which are only a guess.
 */
model Contact {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  email     String? @db.Citext
  name      String?
  phone     String?
  company   String?
  /// Agent-written notes about the person, not about any one conversation.
  notes     String?

  /// Values for the account's own field definitions. Validated against them on write.
  customFields Json @default("{}") @map("custom_fields")

  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  visitors Visitor[]
  tickets  Ticket[]

  @@unique([accountId, id])
  /// One contact per address per account. Citext, so casing cannot create a second person.
  @@unique([accountId, email])
  @@index([accountId, lastSeenAt(sort: Desc)])
  // Substring search over the contact list. Trigram GIN for the same reason as the inbox.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("contacts")
}

/// A field the account has decided it wants to record about people. Data, not code.
model ContactFieldDefinition {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String           @map("account_id") @db.Uuid
  key       String
  label     String
  type      ContactFieldType @default(text)
  /// Only meaningful for `select`. Empty for every other type.
  options   String[]         @default([])
  position  Int              @default(0)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, key])
  @@index([accountId, position])
  @@map("contact_field_definitions")
}

// -----------------------------------------------------------------------------
// Knowledge base
// -----------------------------------------------------------------------------

/**
 * A section of one website's help centre.
 * Scoped to a property rather than to the account: two websites of the same business often help
 * entirely different audiences, and a shared category list would put a plumbing article in front
 * of somebody reading about accountancy.
 */
model KbCategory {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId   String  @map("account_id") @db.Uuid
  propertyId  String  @map("property_id") @db.Uuid
  name        String
  /// Appears in the public URL. Unique per property so two sections cannot fight over one address.
  slug        String  @db.Citext
  description String?
  position    Int     @default(0)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  account  Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  property Property    @relation(fields: [accountId, propertyId], references: [accountId, id], onDelete: Cascade)
  articles KbArticle[]

  @@unique([accountId, id])
  @@unique([propertyId, slug])
  @@index([accountId, propertyId, position])
  @@map("kb_categories")
}

/**
 * One help article.
 * `body` is markdown, stored exactly as written and rendered on the way out - never on the way in.
 * The same rule the transcript follows: what somebody wrote is kept intact, and what a browser is
 * shown is a decision made at render time, where the escaping lives.
 */
model KbArticle {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId  String  @map("account_id") @db.Uuid
  propertyId String  @map("property_id") @db.Uuid
  categoryId String? @map("category_id") @db.Uuid

  slug    String  @db.Citext
  title   String
  /// A short summary for the list and for search results. Written, not generated from the body.
  excerpt String?
  body    String

  status      ArticleStatus @default(draft)
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(6)

  authorMemberId String? @map("author_member_id") @db.Uuid

  /// Counted on public reads only. An author previewing their own draft is not a reader.
  viewCount       Int @default(0) @map("view_count")
  /// How often this article was offered as an answer and actually helped. Phase 10 reports on it.
  helpfulCount    Int @default(0) @map("helpful_count")
  notHelpfulCount Int @default(0) @map("not_helpful_count")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  account           Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  property          Property           @relation(fields: [accountId, propertyId], references: [accountId, id], onDelete: Cascade)
  category          KbCategory?        @relation(fields: [accountId, categoryId], references: [accountId, id], onDelete: SetNull)
  knowledgeDocument KnowledgeDocument?

  @@unique([accountId, id])
  @@unique([propertyId, slug])
  /// The public list: everything published on one website, newest first.
  @@index([accountId, propertyId, status, publishedAt(sort: Desc)])
  @@index([accountId, categoryId, status])
  // Search. Substring matching cannot use a B-tree, so both searchable columns get a trigram GIN
  // index - the same reasoning as the inbox, and the same trade: writes cost a little more so
  // that "what was that article about refunds" is a query rather than a scan.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([body(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("kb_articles")
}

// -----------------------------------------------------------------------------
// Tickets
//
// A conversation is a moment; a ticket is a commitment. The difference that drives the model is
// the channel: a conversation is answered in a widget the person has open, and a ticket is
// answered by email to somebody who has closed the tab and gone to lunch. Everything below
// follows from that - a stable human number to quote, a requester address captured at creation
// rather than followed through a join, and a hard line between what is sent and what is not.
// -----------------------------------------------------------------------------

model Ticket {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId  String @map("account_id") @db.Uuid
  /// Which website it came in through. Tickets are scoped like everything else a restricted agent
  /// can see.
  propertyId String @map("property_id") @db.Uuid

  /// Per-account, gapless, and what everybody quotes. Allocated under the account row's lock.
  number Int

  /// The person, when we know them. Null is normal: somebody can write in before they are anybody.
  contactId      String? @map("contact_id") @db.Uuid
  /// Where it came from, when it came from a chat. Kept as a link, not as ownership.
  conversationId String? @map("conversation_id") @db.Uuid

  /**
   * The address the answer goes to, copied at creation rather than read through the contact.
   * A contact's address can be corrected later, and an email that has already gone out went to
   * the address that was true at the time; a ticket that silently rewrites its own history makes
   * "who did we tell" unanswerable.
   */
  requesterEmail String  @map("requester_email") @db.Citext
  requesterName  String? @map("requester_name")

  subject  String
  status   TicketStatus   @default(open)
  priority TicketPriority @default(normal)
  tags     String[]       @default([])

  assignedMemberId String? @map("assigned_member_id") @db.Uuid
  departmentId     String? @map("department_id") @db.Uuid

  /// Gapless per-ticket counter, incremented with every message insert. Same reasoning as
  /// `Conversation.messageSeq`: timestamps are ambiguous, counters are not.
  messageSeq Int @default(0) @map("message_seq")

  /// First *public* agent reply. Recorded once and never overwritten - an internal note is not a
  /// response to anybody, and counting it would make the response-time report a lie.
  firstResponseAt DateTime? @map("first_response_at") @db.Timestamptz(6)
  lastMessageAt   DateTime  @default(now()) @map("last_message_at") @db.Timestamptz(6)
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(6)
  closedAt        DateTime? @map("closed_at") @db.Timestamptz(6)

  createdByMemberId String? @map("created_by_member_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  account        Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  property       Property        @relation(fields: [accountId, propertyId], references: [accountId, id], onDelete: Cascade)
  contact        Contact?        @relation(fields: [accountId, contactId], references: [accountId, id], onDelete: SetNull)
  conversation   Conversation?   @relation(fields: [accountId, conversationId], references: [accountId, id], onDelete: SetNull)
  assignedMember AccountMember?  @relation("TicketAssignee", fields: [accountId, assignedMemberId], references: [accountId, id], onDelete: SetNull)
  department     Department?     @relation(fields: [accountId, departmentId], references: [accountId, id], onDelete: SetNull)
  messages       TicketMessage[]
  emails         EmailDelivery[]

  @@unique([accountId, id])
  /// The number a person quotes has to resolve to exactly one ticket.
  @@unique([accountId, number])
  /// The queue: one account's open work, most recently touched first.
  @@index([accountId, status, lastMessageAt(sort: Desc)])
  @@index([accountId, propertyId, status])
  @@index([accountId, assignedMemberId, status])
  @@index([accountId, contactId])
  @@index([accountId, conversationId])
  /// "Where is that ticket about the broken invoice" - substring search over the subject.
  @@index([subject(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("tickets")
}

model TicketMessage {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  ticketId  String @map("ticket_id") @db.Uuid

  /// Position in the ticket. Gapless, allocated with the insert.
  seq Int

  authorType     TicketAuthorType @map("author_type")
  /// Set for `agent`. Null for a contact or for the system, which have no membership.
  authorMemberId String?          @map("author_member_id") @db.Uuid

  visibility TicketMessageVisibility @default(public)
  body       String

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  account      Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ticket       Ticket          @relation(fields: [accountId, ticketId], references: [accountId, id], onDelete: Cascade)
  authorMember AccountMember?  @relation("TicketMessageAuthor", fields: [accountId, authorMemberId], references: [accountId, id], onDelete: SetNull)
  emails       EmailDelivery[]

  @@unique([accountId, id])
  @@unique([ticketId, seq])
  @@index([accountId, ticketId, createdAt])
  @@map("ticket_messages")
}

/**
 * What we tried to send, and what happened.
 * Enqueuing an email is not sending one. Without a record, "did the customer ever hear back" is
 * answerable only by asking the customer - and a provider that silently rejects every message to a
 * domain looks exactly like a quiet week. The row is written when the job is queued and updated by
 * the worker, so a `queued` row that never moved is itself the alarm.
 */
model EmailDelivery {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Null for platform mail that belongs to no tenant.
  accountId String? @map("account_id") @db.Uuid

  /// Which message this was, for grouping and for "resend the last one".
  template String
  toEmail  String @map("to_email") @db.Citext
  subject  String

  status   EmailDeliveryStatus @default(queued)
  /// The provider's own words when it refused. Never shown to a visitor.
  error    String?
  attempts Int                 @default(0)

  ticketId        String? @map("ticket_id") @db.Uuid
  ticketMessageId String? @map("ticket_message_id") @db.Uuid

  queuedAt DateTime  @default(now()) @map("queued_at") @db.Timestamptz(6)
  sentAt   DateTime? @map("sent_at") @db.Timestamptz(6)

  account       Account?       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ticket        Ticket?        @relation(fields: [accountId, ticketId], references: [accountId, id], onDelete: Cascade)
  ticketMessage TicketMessage? @relation(fields: [accountId, ticketMessageId], references: [accountId, id], onDelete: SetNull)

  @@index([accountId, queuedAt(sort: Desc)])
  @@index([status, queuedAt])
  @@index([accountId, ticketId])
  @@map("email_deliveries")
}

// -----------------------------------------------------------------------------
// Analytics
//
// Rollups, not an event stream. Every number below is derivable from tables this product already
// keeps - conversations, messages, tickets, visitors - so a parallel event log would be a second
// copy of the truth that can disagree with the first. What these tables buy is speed: a report
// over ninety days reads ninety rows instead of aggregating millions of messages, and it can be
// rebuilt from the source at any time, which is what makes a wrong number fixable rather than
// permanent.
// -----------------------------------------------------------------------------

/**
 * One day of one website, in the account's own timezone.
 * The timezone matters more than it looks: "yesterday" for a team in Auckland is not the window a
 * UTC `date_trunc` would give them, and a daily report whose days do not match the days people
 * worked is worse than no report.
 */
model DailyMetric {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId  String @map("account_id") @db.Uuid
  propertyId String @map("property_id") @db.Uuid

  /// Midnight of the day, in the account's timezone, stored as a date.
  day DateTime @db.Date

  conversationsStarted Int @default(0) @map("conversations_started")
  conversationsClosed  Int @default(0) @map("conversations_closed")
  messagesFromVisitors Int @default(0) @map("messages_from_visitors")
  messagesFromAgents   Int @default(0) @map("messages_from_agents")

  /**
   * Sum and count rather than an average.
   * Averages of averages are wrong, and a week's figure has to be computable from seven days'
   * rows. Keeping the numerator and the denominator makes that arithmetic honest.
   */
  firstResponseCount   Int @default(0) @map("first_response_count")
  firstResponseSeconds Int @default(0) @map("first_response_seconds")
  resolutionCount      Int @default(0) @map("resolution_count")
  resolutionSeconds    Int @default(0) @map("resolution_seconds")

  /// Visitors whose first-ever sight of this website was on this day.
  newVisitors     Int @default(0) @map("new_visitors")
  /// Distinct visitors who started a conversation on this day.
  engagedVisitors Int @default(0) @map("engaged_visitors")

  ticketsOpened   Int @default(0) @map("tickets_opened")
  ticketsResolved Int @default(0) @map("tickets_resolved")

  /// When this row was last derived from the source tables.
  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)

  account  Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [accountId, propertyId], references: [accountId, id], onDelete: Cascade)

  @@unique([accountId, propertyId, day])
  @@index([accountId, day])
  @@map("daily_metrics")
}

/// The same day, cut by who did the work. Separate table because the questions are different:
/// one is "how is this website doing", the other is "how is this person doing", and joining them
/// into one wide row would make every query carry columns it does not want.
model DailyAgentMetric {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  memberId  String @map("member_id") @db.Uuid

  day DateTime @db.Date

  messagesSent         Int @default(0) @map("messages_sent")
  conversationsClosed  Int @default(0) @map("conversations_closed")
  firstResponseCount   Int @default(0) @map("first_response_count")
  firstResponseSeconds Int @default(0) @map("first_response_seconds")
  ticketRepliesSent    Int @default(0) @map("ticket_replies_sent")

  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)

  account Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  member  AccountMember @relation(fields: [accountId, memberId], references: [accountId, id], onDelete: Cascade)

  @@unique([accountId, memberId, day])
  @@index([accountId, day])
  @@map("daily_agent_metrics")
}

// -----------------------------------------------------------------------------
// Integrations
//
// Two ways in, and one way out. An API key lets somebody else's code read and write through the
// same routes an agent uses, with fewer permissions. A webhook lets us tell somebody else's code
// that something happened, without them polling for it.
// -----------------------------------------------------------------------------

/**
 * A credential that is not a person.
 * `ActorType.api_key` already existed in this schema, which is the shape of the answer: a key is
 * another kind of actor with a smaller permission set, not a parallel authentication system with
 * its own rules. It therefore goes through the same tenant context, the same permission checks and
 * the same audit log as a member does.
 */
model ApiKey {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  name String

  /**
   * The visible half of the key: an id, not a secret.
   * Every request looks the key up by this rather than scanning hashes, and it is what the
   * dashboard shows so a person can tell two keys apart after the secret is gone forever.
   */
  prefix String @unique

  /// SHA-256 of the secret half. See ADR-070 for why this is not Argon2.
  secretHash String @map("secret_hash")

  /// What this key may do. A subset of the tenant permission strings, validated on write.
  scopes String[] @default([])

  /**
   * Restrict a key to certain websites, exactly as a restricted member is restricted.
   * Empty means every website in the account.
   */
  propertyIds String[] @default([]) @map("property_ids")

  /// Updated at most once a minute, so a busy key does not write on every request.
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  createdByMemberId String? @map("created_by_member_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, id])
  @@index([accountId, revokedAt])
  @@map("api_keys")
}

/// Where an account wants to be told, and about what.
model Webhook {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  name String
  url  String

  /**
   * The signing secret. Shown once, at creation, and never again.
   * Stored in plain text rather than hashed, because unlike a password we have to be able to
   * *produce* it on every delivery to sign with. That is a real difference in kind, and the
   * mitigation is that it authorises nothing: it only proves a delivery came from us.
   */
  secret String

  /// Which events. An empty list means nothing is sent - never "everything".
  events String[] @default([])

  enabled Boolean @default(true)

  /**
   * Consecutive failures, reset by any success.
   * An endpoint that has failed many times in a row is gone, not slow, and continuing to retry it
   * forever is how a queue fills up with deliveries nobody will ever receive.
   */
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  disabledAt          DateTime? @map("disabled_at") @db.Timestamptz(6)
  disabledReason      String?   @map("disabled_reason")
  lastDeliveryAt      DateTime? @map("last_delivery_at") @db.Timestamptz(6)

  createdByMemberId String? @map("created_by_member_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  account    Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@unique([accountId, id])
  @@index([accountId, deletedAt])
  @@map("webhooks")
}

/**
 * One attempt to tell somebody something - and the record of how it went.
 * The row is the queue. It is written in the same request that caused the event, so a delivery
 * cannot be lost by a worker restart or a Redis flush; the job that carries it is an optimisation
 * for latency, and a sweeper picks up anything the job never got to. That is the difference
 * between "we told them" and "we published something and hoped".
 */
model WebhookDelivery {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  webhookId String @map("webhook_id") @db.Uuid

  event   String
  /// Exactly the bytes that were signed and sent, so a replay is a replay and not a re-render.
  payload Json

  status   WebhookDeliveryStatus @default(pending)
  attempts Int                   @default(0)

  responseStatus Int?    @map("response_status")
  /// Trimmed hard. An endpoint that answers with a megabyte of HTML must not fill this table.
  responseBody   String? @map("response_body")
  error          String?

  /// When this becomes due. Backoff is expressed by moving this forward, not by sleeping.
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  deliveredAt   DateTime? @map("delivered_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  webhook Webhook @relation(fields: [accountId, webhookId], references: [accountId, id], onDelete: Cascade)

  @@unique([accountId, id])
  @@index([accountId, webhookId, createdAt(sort: Desc)])
  /// The sweeper's query: everything due, oldest first.
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

enum WebhookDeliveryStatus {
  pending
  /// Accepted by the endpoint with a 2xx.
  delivered
  /// Out of attempts. Kept, so somebody can see what was missed.
  failed

  @@map("webhook_delivery_status")
}

/**
 * A kill switch, operated from the platform console.
 * Deliberately not a general-purpose experiment framework. Each row corresponds to one capability
 * that is genuinely checked in one place in the code, and the set of keys is closed - a flag whose
 * key nothing reads is a switch that does nothing, which is worse than no switch at all because
 * somebody will eventually flip it in an incident and believe it helped.
 * `enabled` is the default for every account. `disabledAccountIds` turns it off for named accounts
 * only, which is the shape an operator actually needs: something is on for everybody and has to be
 * taken away from the one account melting the storage bill.
 */
model FeatureFlag {
  id  String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key String @unique

  description        String
  enabled            Boolean  @default(true)
  /// Accounts this is off for, whatever `enabled` says.
  disabledAccountIds String[] @default([]) @map("disabled_account_ids")

  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedByAdminId String?  @map("updated_by_admin_id") @db.Uuid

  @@map("feature_flags")
}

/**
 * What a platform administrator did.
 * Separate from `audit_logs`, which is tenant-scoped and readable by the account it belongs to.
 * These are actions taken *on* accounts by people outside them - suspending, resuming - and
 * an account must not be able to read them, nor a platform action be lost among a tenant's own.
 */
model PlatformAuditLog {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId String @map("admin_id") @db.Uuid

  action    String
  /// The account acted upon, when there is one.
  accountId String? @map("account_id") @db.Uuid

  metadata Json    @default("{}")
  ip       String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@index([accountId, createdAt(sort: Desc)])
  @@map("platform_audit_logs")
}

// -----------------------------------------------------------------------------
// Geolocation
//
// Built from the five regional internet registries' own daily allocation files rather than a
// vendor database: no licence, no key, no per-lookup call, and the same upstream every vendor
// starts from. Country only - an IP address says where a network is, and nothing finer than that
// is honest. See packages/core/src/geo.
// -----------------------------------------------------------------------------

/// One allocated block and the country the registry allocated it to. Rebuilt wholesale by the
/// refresh job; never edited by hand. The GiST index is what makes `network >>= $ip` fast.
model IpCountryRange {
  id       Int                  @id @default(autoincrement())
  /// Optional to Prisma only. A model with a *required* `Unsupported` field loses its create and
  /// upsert operations, which breaks the id-assigning client extension for every model at once.
  /// The migration adds a CHECK constraint so the column can never actually be null; Prisma
  /// does not model CHECK constraints, so the two stay in agreement.
  network  Unsupported("cidr")?
  country  String               @db.Char(2)
  registry String               @db.VarChar(8)

  @@index([network(ops: raw("inet_ops"))], type: Gist, map: "ip_country_ranges_network_idx")
  @@map("ip_country_ranges")
}

/// When the ranges were last rebuilt and from what, so the console can say whether the data is
/// fresh, stale, or was never loaded - the difference between "no flag because we do not know"
/// and "no flag because nobody ran the job".
model GeoDataset {
  id          String    @id
  refreshedAt DateTime? @map("refreshed_at") @db.Timestamptz(6)
  rangeCount  Int       @default(0) @map("range_count")
  /// Per-registry outcome of the last refresh: fetched-at, record count, or the error.
  sources     Json      @default("{}")
  lastError   String?   @map("last_error")
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("geo_datasets")
}

// -----------------------------------------------------------------------------
// Billing
//
// Plans are a catalogue the platform operator edits in the console; Stripe holds the money. The
// tables here are the product's own view - what an account is entitled to, and a mirror of what
// Stripe has told us - so that nothing a customer sees requires a call to Stripe, and so the
// dashboard keeps working if Stripe is slow. Stripe is the source of truth for the subscription's
// status and every invoice; webhooks keep this side in step.
// -----------------------------------------------------------------------------

enum BillingInterval {
  month
  year

  @@map("billing_interval")
}

/// Stripe's own lifecycle, plus `none` for an account that has never had a paid subscription
/// (the free plan, or one the operator assigned by hand).
enum SubscriptionStatus {
  none
  active
  past_due
  unpaid
  canceled
  incomplete
  incomplete_expired

  @@map("subscription_status")
}

enum BillingProvider {
  /// Free, or assigned by the operator. No Stripe objects behind it.
  manual
  stripe

  @@map("billing_provider")
}

/// Stripe's invoice statuses, mirrored. `draft` invoices are never shown to a customer.
enum InvoiceStatus {
  draft
  open
  paid
  uncollectible
  void

  @@map("invoice_status")
}

/// What is sold. Edited in the platform console; synced to a Stripe Product with one Price per
/// interval. Changing a price creates a new Stripe Price and retires the old one - existing
/// subscriptions keep the price they signed up at, which is how Stripe works and what a customer
/// expects.
model Plan {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stable handle the code can rely on: `free`, `starter`, `growth`, `custom`. Operator-created
  /// plans get whatever key the operator chooses.
  key         String  @unique
  name        String
  tagline     String?
  description String?

  monthlyPriceCents Int    @default(0) @map("monthly_price_cents")
  annualPriceCents  Int    @default(0) @map("annual_price_cents")
  currency          String @default("usd") @db.Char(3)

  // --- what the plan allows ------------------------------------------------
  /// null = unlimited.
  maxProperties     Int?    @map("max_properties")
  /// null = unlimited. Counts active members and pending invitations together.
  maxMembers        Int?    @map("max_members")
  aiAgent           Boolean @default(false) @map("ai_agent")
  /// AI replies per calendar month, per account. null = unlimited. Meaningless when `aiAgent` is off.
  aiRepliesPerMonth Int?    @map("ai_replies_per_month")
  /// Public API keys and outbound webhooks.
  integrations      Boolean @default(false)
  /// Hide "Powered by" in the widget.
  removeBranding    Boolean @default(false) @map("remove_branding")

  /// "Talk to us" rather than a checkout button. Price fields are ignored.
  isContactSales Boolean @default(false) @map("is_contact_sales")
  /// Shown on the pricing page and the upgrade screen.
  isPublic       Boolean @default(true) @map("is_public")
  /// The plan a new account lands on. Exactly one plan should have this.
  isDefault      Boolean @default(false) @map("is_default")
  /// Retired plans keep their rows so existing subscriptions still resolve.
  isActive       Boolean @default(true) @map("is_active")
  sortOrder      Int     @default(0) @map("sort_order")

  stripeProductId      String? @map("stripe_product_id")
  stripeMonthlyPriceId String? @map("stripe_monthly_price_id")
  stripeAnnualPriceId  String? @map("stripe_annual_price_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions Subscription[]

  @@index([isActive, sortOrder])
  @@map("plans")
}

/// One per account, always. Created with the account on the default plan, so "does this account
/// have a subscription" is never a question - only "which plan, and is it paid up".
model Subscription {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String @unique @map("account_id") @db.Uuid
  planId    String @map("plan_id") @db.Uuid

  status   SubscriptionStatus @default(none)
  interval BillingInterval    @default(month)
  provider BillingProvider    @default(manual)

  stripeCustomerId     String? @map("stripe_customer_id")
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")

  currentPeriodStart DateTime? @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime? @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt         DateTime? @map("canceled_at") @db.Timestamptz(6)

  /// When the first payment failed. The grace window the operator configures counts from here.
  pastDueSince DateTime? @map("past_due_since") @db.Timestamptz(6)
  /// When the dashboard was locked for non-payment. Cleared when a payment lands.
  lockedAt     DateTime? @map("locked_at") @db.Timestamptz(6)

  /// Why the operator assigned this plan by hand, when they did.
  note String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id])

  @@index([planId])
  @@index([status, pastDueSince])
  @@map("subscriptions")
}

/// A mirror of a Stripe invoice: enough to list it, link to it, and email about it. Stripe keeps
/// the PDF and the line items; this row is what the dashboard shows without asking Stripe.
model Invoice {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId       String        @map("account_id") @db.Uuid
  stripeInvoiceId String        @unique @map("stripe_invoice_id")
  /// Stripe's human-readable number, e.g. `ABCD1234-0001`. Null until finalised.
  number          String?
  status          InvoiceStatus @default(open)

  amountDueCents  Int    @map("amount_due_cents")
  amountPaidCents Int    @default(0) @map("amount_paid_cents")
  currency        String @db.Char(3)

  planName    String?   @map("plan_name")
  periodStart DateTime? @map("period_start") @db.Timestamptz(6)
  periodEnd   DateTime? @map("period_end") @db.Timestamptz(6)

  hostedInvoiceUrl String? @map("hosted_invoice_url")
  invoicePdfUrl    String? @map("invoice_pdf_url")

  issuedAt DateTime? @map("issued_at") @db.Timestamptz(6)
  paidAt   DateTime? @map("paid_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt(sort: Desc)])
  @@map("invoices")
}

/// Every Stripe event this deployment has handled, by Stripe's own id. Stripe delivers at least
/// once, and a webhook that runs twice must not send two receipts or lock an account twice.
model StripeEvent {
  id          String    @id
  type        String
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  error       String?

  @@index([receivedAt(sort: Desc)])
  @@map("stripe_events")
}

/// "I need something bigger": the custom-plan form. Stored as well as emailed, so a request the
/// operator's mail filter ate is still in the console.
model BillingEnquiry {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  email     String
  name      String
  message   String
  /// Roughly what they said they need, when they said it.
  wants     Json      @default("{}")
  handledAt DateTime? @map("handled_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([handledAt, createdAt(sort: Desc)])
  @@map("billing_enquiries")
}

/// Platform-wide configuration the operator sets in the console: Stripe keys, billing contact,
/// grace period. Secrets are encrypted at rest with `SETTINGS_ENCRYPTION_KEY`; `encrypted` says
/// which rows are, so a reader never has to guess.
model PlatformSetting {
  key              String   @id
  value            String
  encrypted        Boolean  @default(false)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedByAdminId String?  @map("updated_by_admin_id") @db.Uuid

  @@map("platform_settings")
}

// -----------------------------------------------------------------------------
// The AI agent
//
// The AI never touches the rest of this schema. It is given text - the property's settings, the
// passages retrieved from `knowledge_chunks`, the last few messages - and it returns text that the
// worker validates before anything is written. What lives here is the configuration, the index
// that retrieval searches, and the record of every turn so "why did it say that" and "what did
// this cost" are queries rather than guesses. See docs/AI_AGENT.md.
// -----------------------------------------------------------------------------

enum AiMode {
  /// People answer. The offline form takes over when nobody is online. Today's behaviour.
  team
  /// The AI answers while no member of the account is online; people take over the moment one is.
  ai_when_offline
  /// The AI answers first, always. A person can still take any conversation over.
  ai
}

enum KnowledgeDocumentKind {
  /// A published help-centre article. Indexed on publish, removed on unpublish.
  article
  /// The "key facts and notes" text the owner types into the AI settings. One per property.
  notes
  /// A page of the website, found by the crawler. Removed when a later crawl no longer finds it.
  page
  /// A file the owner uploaded - a PDF price list, a DOCX prospectus. One document per file.
  file
}

enum KnowledgeFileStatus {
  /// A signed upload URL was issued; the bytes may or may not have arrived.
  pending
  /// The upload was confirmed and the worker is extracting its text.
  processing
  /// Extracted and indexed.
  ready
  /// Could not be read or indexed; `error` says why. The owner can delete it and try again.
  failed
}

enum AiDecision {
  /// The passages answered the question; the model's text was posted.
  answer
  /// A greeting, small talk or a general question that needed no fact about the business; the
  /// model's own words were posted, uncited.
  chat
  /// Not in the content, or needs a person or the backend: the ticket offer was posted.
  ticket
  /// The visitor asked for a person: handed off to the team, or the ticket offer when nobody is online.
  human
  /// Every provider failed, or the model's reply did not fit the contract: the fallback sentence
  /// and the ticket offer were posted. Counted so an outage is visible.
  failed
}

enum AiProviderKind {
  local
  openai
  deepseek
}

/// Per-website configuration of the AI agent. Created on first save; absent means `team`.
model AiSetting {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId  String @map("account_id") @db.Uuid
  propertyId String @map("property_id") @db.Uuid

  mode                      AiMode @default(team)
  /// What the widget calls it. Public by nature - it is the sender name on every reply.
  assistantName             String @default("AI assistant") @map("assistant_name")
  /// A short description of the business and how to speak, in the owner's words. Goes into the
  /// system prompt as-is, so it is bounded and never contains anything secret.
  instructions              String @default("")
  /// Opening hours, phone numbers, addresses - facts the owner would rather type than have the
  /// crawler guess. Indexed as the `notes` document and always searched first.
  keyFacts                  String @default("") @map("key_facts")
  /// Said when the AI cannot help, before the ticket offer.
  ticketOfferText           String @default("I can't help with that from here, but our team can. Would you like me to open a support ticket so they can follow up by email?") @map("ticket_offer_text")
  /// Said when the AI hands a conversation to a person who is online.
  handoffText               String @default("I'm passing this to a member of our team - they'll pick it up right here in a moment.") @map("handoff_text")
  /// After this many AI replies in one conversation the AI stops and offers a ticket. A loop guard.
  maxRepliesPerConversation Int    @default(50) @map("max_replies_per_conversation")

  // --- the website crawl -----------------------------------------------------
  /// The most pages one crawl reads. The owner can raise it; the operator's ceiling is in code.
  crawlMaxPages     Int       @default(200) @map("crawl_max_pages")
  crawlStartedAt    DateTime? @map("crawl_started_at") @db.Timestamptz(6)
  lastCrawledAt     DateTime? @map("last_crawled_at") @db.Timestamptz(6)
  crawlPagesFound   Int       @default(0) @map("crawl_pages_found")
  crawlPagesIndexed Int       @default(0) @map("crawl_pages_indexed")
  /// Why the last crawl could not read the site, in a sentence the owner can act on. Null after a good one.
  crawlError        String?   @map("crawl_error")
  /// Paths the crawl skips: `/blog/*`, `/cart`, `*.pdf`. Matched against the URL path.
  crawlExclude      String[]  @default([]) @map("crawl_exclude")

  /// When the mode was last set to something other than `team`. Reporting only.
  enabledAt DateTime? @map("enabled_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  account  Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [accountId, propertyId], references: [accountId, id], onDelete: Cascade)

  @@unique([accountId, id])
  @@unique([accountId, propertyId])
  @@map("ai_settings")
}

/// One thing the AI may answer from: an article, the notes. The text is kept whole so a chunk can
/// be shown in context and so re-chunking never needs the source again.
model KnowledgeDocument {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId  String                @map("account_id") @db.Uuid
  propertyId String                @map("property_id") @db.Uuid
  kind       KnowledgeDocumentKind
  /// The article this mirrors, for `article` documents. One document per article.
  articleId  String?               @map("article_id") @db.Uuid

  title       String
  /// Where "answered from" points. Null for the notes.
  url         String?
  text        String
  /// sha256 of `title + text`. Unchanged hash, unchanged chunks: a re-sync costs nothing.
  contentHash String  @map("content_hash")
  tokenCount  Int     @default(0) @map("token_count")
  chunkCount  Int     @default(0) @map("chunk_count")

  indexedAt  DateTime? @map("indexed_at") @db.Timestamptz(6)
  /// The last indexing failure, kept until the next success, so the settings page can say why.
  error      String?
  /// For pages: when the crawler last found this URL. A crawl that no longer finds it removes it.
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  account  Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  property Property         @relation(fields: [accountId, propertyId], references: [accountId, id], onDelete: Cascade)
  article  KbArticle?       @relation(fields: [accountId, articleId], references: [accountId, id], onDelete: Cascade)
  chunks   KnowledgeChunk[]
  file     KnowledgeFile?

  @@unique([accountId, id])
  @@unique([accountId, articleId])
  /// One document per page URL per website.
  @@unique([accountId, propertyId, url])
  @@index([accountId, propertyId, kind])
  @@map("knowledge_documents")
}

/// A file the owner uploaded for the assistant to read. The bytes live in object storage under a
/// key made of ids; the text the worker extracts becomes a `file` knowledge document, and the two
/// are deleted together. `status` is the upload's life: signed, confirmed, indexed, or failed.
model KnowledgeFile {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId  String  @map("account_id") @db.Uuid
  propertyId String  @map("property_id") @db.Uuid
  /// The document made from it, once the text has been extracted.
  documentId String? @unique @map("document_id") @db.Uuid

  fileName           String              @map("file_name")
  contentType        String              @default("") @map("content_type")
  byteSize           Int                 @default(0) @map("byte_size")
  storageKey         String              @map("storage_key")
  status             KnowledgeFileStatus @default(pending)
  error              String?
  /// The member who uploaded it. Null once they leave.
  uploadedByMemberId String?             @map("uploaded_by_member_id") @db.Uuid

  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  account  Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  property Property           @relation(fields: [accountId, propertyId], references: [accountId, id], onDelete: Cascade)
  document KnowledgeDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@unique([accountId, id])
  @@index([accountId, propertyId, createdAt])
  @@map("knowledge_files")
}

/// A passage of roughly 400 tokens, with its embedding and its full-text vector. Retrieval is
/// hybrid - vector similarity for meaning, full text for exact strings such as a product code -
/// and both indexes live here. The embedding column is `vector(768)`; Prisma cannot type it, so
/// the AI module reads and writes it with raw SQL, always filtered by account and property first.
model KnowledgeChunk {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId  String @map("account_id") @db.Uuid
  propertyId String @map("property_id") @db.Uuid
  documentId String @map("document_id") @db.Uuid
  ordinal    Int

  /// The heading path the passage sits under, so a chunk knows which section it came from.
  heading    String?
  text       String
  tokenCount Int                         @default(0) @map("token_count")
  /// NOT NULL in the database. Optional here only because Prisma removes `create`/`update` from
  /// a model with a *required* unsupported field, and the client extension in src/client.ts is
  /// typed over every model's `create`. Rows are written by raw SQL with the vector supplied.
  embedding  Unsupported("vector(768)")?
  /// Generated by the database from `text`; never written by the application.
  search     Unsupported("tsvector")?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  account  Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  document KnowledgeDocument @relation(fields: [accountId, documentId], references: [accountId, id], onDelete: Cascade)

  @@unique([documentId, ordinal])
  @@index([accountId, propertyId])
  @@map("knowledge_chunks")
}

/// Every time the AI was asked to reply: what it decided, which provider answered, what it cost.
/// The audit trail behind the transcript, and what the usage counts read.
model AiTurn {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId        String  @map("account_id") @db.Uuid
  propertyId       String  @map("property_id") @db.Uuid
  conversationId   String  @map("conversation_id") @db.Uuid
  /// The visitor message that triggered the turn.
  visitorMessageId String  @map("visitor_message_id") @db.Uuid
  /// The bot message that was posted, when one was.
  replyMessageId   String? @map("reply_message_id") @db.Uuid

  decision AiDecision
  provider AiProviderKind?
  model    String?
  /// Set when the local provider was skipped or failed and the fallback answered. Visible in the
  /// console so an ailing local model is noticed.
  fellBack Boolean         @default(false) @map("fell_back")

  promptTokens      Int      @default(0) @map("prompt_tokens")
  completionTokens  Int      @default(0) @map("completion_tokens")
  latencyMs         Int      @default(0) @map("latency_ms")
  /// The chunks that were in the prompt, in rank order.
  retrievedChunkIds String[] @default([]) @map("retrieved_chunk_ids") @db.Uuid
  /// The chunk ids the model said it used, after validation.
  citedChunkIds     String[] @default([]) @map("cited_chunk_ids") @db.Uuid
  /// What went wrong, for `failed` turns and for turns that fell back.
  error             String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [accountId, propertyId], references: [accountId, id], onDelete: Cascade)
  conversation Conversation @relation(fields: [accountId, conversationId], references: [accountId, id], onDelete: Cascade)

  /// The monthly usage count.
  @@index([accountId, createdAt(sort: Desc)])
  @@index([conversationId, createdAt])
  @@map("ai_turns")
}
