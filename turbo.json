{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "APP_URL",
    "API_URL",
    "REALTIME_URL",
    "WIDGET_URL",
    "VISITOR_TOKEN_SECRET",
    "S3_ENDPOINT",
    "S3_BUCKET",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "SMTP_HOST",
    "SMTP_PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_OUTPUT_STANDALONE"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:unit": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "@smartchat/database#typecheck": {
      "dependsOn": ["^build", "build"]
    },
    "@smartchat/database#lint": {
      "dependsOn": ["^build", "build"]
    },
    "@smartchat/database#test": {
      "dependsOn": ["^build", "build"],
      "outputs": ["coverage/**"]
    },
    "@smartchat/database#test:unit": {
      "dependsOn": ["^build", "build"]
    }
  }
}
