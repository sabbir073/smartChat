{
  "name": "smartchat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SmartChat \u2014 multi-tenant live chat SaaS platform",
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "//": "Duplicated in pnpm-workspace.yaml on purpose: pnpm 9 reads overrides from here, pnpm 10+ reads them from there, and this repo must resolve the same way under both.",
    "overrides": {
      "postcss": "^8.5.28",
      "deepmerge-ts": "^8.0.2",
      "esbuild": "^0.28.1"
    }
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,md,yml,yaml,css}\"",
    "clean": "turbo run clean && rimraf node_modules",
    "db:generate": "pnpm --filter @smartchat/database generate",
    "db:migrate": "pnpm --filter @smartchat/database migrate:dev",
    "db:deploy": "pnpm --filter @smartchat/database migrate:deploy",
    "db:seed": "pnpm --filter @smartchat/database seed",
    "db:reset": "pnpm --filter @smartchat/database reset",
    "db:studio": "pnpm --filter @smartchat/database studio",
    "smoke": "node scripts/smoke.mjs",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f --tail=100",
    "docker:rebuild": "docker compose build && docker compose up -d",
    "docker:migrate": "docker compose run --rm migrate",
    "docker:seed": "docker compose exec -w /app/packages/database api ./node_modules/.bin/tsx prisma/seed.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test:unit",
    "e2e:realtime": "node scripts/e2e-realtime.mjs",
    "e2e:team": "node scripts/e2e-team.mjs",
    "e2e:automation": "node scripts/e2e-automation.mjs",
    "e2e:files": "node scripts/e2e-files.mjs",
    "e2e:kb": "node scripts/e2e-kb.mjs",
    "e2e:tickets": "node scripts/e2e-tickets.mjs",
    "e2e:reports": "node scripts/e2e-reports.mjs",
    "e2e:integrations": "node scripts/e2e-integrations.mjs",
    "e2e:platform": "node scripts/e2e-platform.mjs",
    "e2e:retention": "node scripts/e2e-retention.mjs",
    "e2e:isolation": "node scripts/e2e-isolation.mjs",
    "e2e:abuse": "node scripts/e2e-abuse.mjs",
    "qa:errors": "node scripts/qa-error-surface.mjs",
    "qa:edge": "node scripts/qa-edge-config.mjs",
    "qa:routes": "node scripts/qa-route-coverage.mjs",
    "qa:availability": "node scripts/qa-single-availability-source.mjs",
    "qa:all": "node scripts/qa-all.mjs",
    "loadtest": "node scripts/loadtest.mjs",
    "backup:rehearse": "node scripts/restore-rehearsal.mjs",
    "rollback:rehearse": "node scripts/rollback-rehearsal.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^5.0.0"
  }
}
